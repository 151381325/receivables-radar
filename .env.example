NODE_ENV=development
HOST=0.0.0.0
PORT=3000
POSTGRES_USER=receivables
POSTGRES_PASSWORD=change-me
POSTGRES_DB=receivables
DATABASE_URL=postgres://receivables:change-me@db:5432/receivables
APP_ORIGIN=https://example.com
SITE_ADDRESS=https://example.com
SESSION_COOKIE_NAME=rr_session
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASS=change-me
MAIL_FROM=sender@example.com
BACKUP_ENCRYPTION_KEY=change-me-to-a-long-random-secret
# Configure COSCLI separately; this command receives BACKUP_FILE in its environment.
COS_UPLOAD_COMMAND=coscli cp "$$BACKUP_FILE" "cos://backup-bucket/receivables/"
BACKUP_INTERVAL_SECONDS=86400
