<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_title"
            android:textColor="#4A260B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="6dp"
            android:text="@string/privacy_intro"
            android:textColor="#5F5148"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="5dp"
            android:text="@string/privacy_notice"
            android:textColor="#5F5148"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/privacy_terms_link"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/privacy_terms_link"
            android:textColor="#C9470B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/privacy_policy_link"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/privacy_policy_link"
            android:textColor="#C9470B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/privacy_accept"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#E64A0B"
            android:text="@string/privacy_accept"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/privacy_reject"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FFF8F0"
            android:text="@string/privacy_reject"
            android:textAllCaps="false"
            android:textColor="#6B4A36"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
